# Copy to .env and fill in real values:
#   cp .env.example .env

# Writable GCS bucket (no gs:// prefix)
GCS_BUCKET=your-bucket-name

# Object prefix under which bad/ and good/ subtrees are written
GCS_PREFIX=time-bucket-repro

# Absolute path on the host to a GCP service-account JSON key
# with storage.objects.create / storage.objects.list on GCS_BUCKET
GCS_CREDENTIALS_FILE=/absolute/path/to/service-account.json

# Kafka topic used by both connectors
TOPIC=load-events

# Optional: pin / override the published SMT release jar
# (default downloads v1.5.0 from GitHub Releases — never built from source)
# SMT_VERSION=1.5.0
# SMT_RELEASE_URL=https://github.com/lensesio/kafka-connect-smt/releases/download/v1.5.0/kafka-connect-smt-1.5.0.jar
# Required when overriding version/URL (default v1.5.0 digest is built-in):
# SMT_SHA256=3a5f93e0d5bb84f7f715b593b1bbc523ecc84467c62110f6a17e6d68005006b5
